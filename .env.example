# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/pospect

# NextAuth
NEXTAUTH_SECRET=generate-a-strong-secret-here
NEXTAUTH_URL=http://localhost:3000

# Admin inicial (primeiro login cria o usuário)
ADMIN_EMAIL=admin@loja.com
ADMIN_PASSWORD=change-me-123

# n8n Webhooks
N8N_WEBHOOK_URL=https://your-n8n.example.com/webhook/prospecting
N8N_WEBHOOK_SECRET=your-webhook-secret

# Google Places
GOOGLE_PLACES_API_KEY=

# PNCP (API pública de consulta — não requer autenticação)
PNCP_BASE_URL=https://pncp.gov.br/api/consulta

# IA (escolha um provider)
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=

# Região padrão da loja
DEFAULT_SEARCH_REGION=São Paulo, SP

# ===== Nprospect: vendas do nRecruit =====
# Caixa de prospecção (use um domínio secundário, nunca o principal)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Danilo | nRecruit
# IMAP (se vazio, usa os dados do SMTP)
IMAP_HOST=
IMAP_PORT=993

# Guarda: limites de envio
SEND_DAILY_LIMIT=20
SEND_WEEKDAYS=2,3,4
SEND_START_HOUR=9
SEND_END_HOUR=11
SEND_TIMEZONE=America/Sao_Paulo
# Aquecimento da caixa nova: começa com 5/dia e sobe 2 por dia de envio até SEND_DAILY_LIMIT
WARMUP_START=
WARMUP_START_LIMIT=5
WARMUP_STEP=2

# IA gratuita (preencha as que tiver; a ordem de tentativa é configurável)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# LLM_ORDER_WRITE=gemini,groq,openrouter,ollama
# LLM_ORDER_CLASSIFY=ollama,groq,gemini,openrouter

NRECRUIT_SIGNUP_URL=https://nrecruit.app
WORKER_INTERVAL_SECONDS=60
